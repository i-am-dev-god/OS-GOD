# Public Supabase client configuration. The publishable key is safe for browsers
# only because every table has row-level security. Never put a service_role or
# secret key in NEXT_PUBLIC_* variables, GitHub Pages, or this repository.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Leave empty for localhost / root hosting. For GitHub project Pages use /REPO_NAME.
NEXT_PUBLIC_BASE_PATH=
